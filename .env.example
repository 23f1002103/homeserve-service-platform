# Copy this file to .env and replace the values for your local PostgreSQL setup.
DATABASE_URL=postgresql+psycopg://postgres:your_password@localhost:5432/homeserve
# Neon provides this direct URL for migrations. Local PostgreSQL can use the
# same value as DATABASE_URL.
DATABASE_URL_UNPOOLED=postgresql+psycopg://postgres:your_password@localhost:5432/homeserve
JWT_SECRET_KEY=replace_with_a_long_random_secret

# Used once to create the initial administrator when the development server starts.
ADMIN_USERNAME=homeserve_admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace_with_a_strong_password

# Public OAuth client ID for Sign in with Google. A client secret is not used
# by the Google Identity Services ID-token flow.
GOOGLE_CLIENT_ID=replace_with_your_web_client_id.apps.googleusercontent.com

# HomeServe platform commission. The professional receives the remaining share.
PLATFORM_COMMISSION_PERCENT=15

# Redis is the queue used by Celery workers and Celery Beat.
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
CELERY_TIMEZONE=Asia/Kolkata
CELERY_TASK_ALWAYS_EAGER=false

# Email settings used by background jobs. For Gmail, use an App Password.
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=replace_with_a_gmail_app_password
MAIL_DEFAULT_SENDER=HomeServe <your_email@gmail.com>



